# ---------------------------------------------------------------------------
# Butterfly Coaching Academy: environment configuration
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for canonical URLs, the
# sitemap, Open Graph tags and links in notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Backend mode ----------------------------------------------------------
# Local development mode. When set to 1 the app runs against an embedded
# PostgreSQL server in .local/pg, stores uploads in .local/uploads and uses
# built-in email + password sign-in. No external accounts are needed.
# Remove this line (or set it to 0) for production and fill in Supabase below.
BCA_LOCAL_MODE=1

# --- Supabase (production) -------------------------------------------------
# Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API keys. SERVER ONLY. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string > "Transaction pooler"
# (port 6543). SERVER ONLY.
DATABASE_URL=
# Storage bucket that holds uploaded media (created by the migrations).
SUPABASE_STORAGE_BUCKET=media

# --- Secrets ---------------------------------------------------------------
# 32+ random characters. Signs form tokens and (in local mode) admin sessions.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# One-time token required to create the first administrator at /admin/setup.
ADMIN_SETUP_TOKEN=

# --- Email notifications (optional) ---------------------------------------
# Resend API key. Without it enquiries are still stored and shown in the admin
# inbox; the app simply records that no notification was sent.
RESEND_API_KEY=
# A verified sender on your Resend domain, e.g. "BCA Website <website@yourdomain.com>"
EMAIL_FROM=
# Where new-enquiry notifications go. Falls back to the contact email in
# Site settings when empty.
ENQUIRY_NOTIFY_TO=

# --- Uploads ---------------------------------------------------------------
# Maximum upload size in MB. Vercel serverless functions accept at most ~4.5 MB.
MAX_UPLOAD_MB=4
