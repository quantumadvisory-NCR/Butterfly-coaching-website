{
  "name": "butterfly-coaching-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/with-db.ts next dev",
    "build": "next build",
    "start": "next start",
    "local:build": "tsx scripts/with-db.ts next build",
    "local:start": "tsx scripts/with-db.ts next start",
    "db:start": "tsx scripts/with-db.ts --hold",
    "db:migrate": "tsx scripts/with-db.ts tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/with-db.ts tsx scripts/seed.ts",
    "db:reset": "tsx scripts/with-db.ts tsx scripts/seed.ts --reset",
    "content:upgrade-home": "tsx scripts/with-db.ts tsx scripts/upgrade-homepage.ts",
    "images:optimise": "tsx scripts/optimise-images.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/with-db.ts --db=bca_test vitest run",
    "test:e2e": "tsx scripts/with-db.ts --db=bca_e2e tsx scripts/e2e-prepare.ts && tsx scripts/with-db.ts --db=bca_e2e playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "docs:images": "tsx scripts/docs-images.ts",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
